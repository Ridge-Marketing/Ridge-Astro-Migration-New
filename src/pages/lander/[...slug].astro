---
/**
 * Lander pages. Replaces Gatsby's lander.js template:
 * b2b-marketing-agency → PPCLanderWrapperCMO, audit → AuditLanderWrapper,
 * anything else → PageHeader + flexible layouts (e.g. full-service-digital-marketing).
 */

import Layout from "@/components/global/Layout.astro";
import parser from "@/lib/parser";
import { theme } from "@/lib/theme";
import { getLanders, getGlobalSettings, extractPath, transformKeys } from "@/lib/wp-client";
import FlexibleLayouts from "@/components/FlexibleLayouts.astro";
import PageHeader from "@/components/layouts/PageHeader.astro";
import PPCLanderWrapperCMO from "@/components/layouts/ppcLander/PPCLanderWrapperCMO.astro";
import AuditLanderWrapper from "@/components/layouts/auditLander/AuditLanderWrapper.astro";

export async function getStaticPaths() {
    const allLanders = await getLanders()

    const landers = allLanders.filter((p: any) => {
        const fields = p.acf?.additional_blog_fields || p.acf?.additionalBlogFields || {};
        return !fields.preview_mode && !fields.previewMode;
    });

    return landers.map((lander: any, index: number) => {
        // Circular prev/next

        return {
            params: { slug: lander.slug },
            props: {
                lander,
            },
        };
    });
}

const { lander }        = Astro.props;

const globalSettings    = await getGlobalSettings().catch(() => null);
const favicon           = globalSettings?.logos?.favicon?.source_url || globalSettings?.logos?.favicon?.sourceUrl || '';

const seo               = lander.yoast_head_json;
const title             = lander.title?.rendered || '';
const uri               = extractPath(lander.link);

// Determine header color
let headerColor         = 'black';
const whiteHeaderPages  = [''];
if (whiteHeaderPages.includes(uri)) {
  headerColor           = 'white';
}
if (lander.acf?.header_color) {
  headerColor           = lander.acf.header_color;
}

// Accent colors
const accentColor       = lander.acf?.accent_color || '#A9CF38';
const secondaryColor    = lander.acf?.secondary_color || '#000000';

const isB2B             = lander.slug === 'b2b-marketing-agency' ? true : false
const isAudit           = uri === '/lander/audit/'
const headerPosition    = isB2B || isAudit ? 'sticky' : 'fixed'

// "AI Audit" ACF group (hero, form_text, steps, pricing…) on the lander's REST acf
const aiAudit           = isAudit && lander.acf?.hero ? lander.acf : null

// Every other lander: page header + flexible layouts (Gatsby's default branch)
const isDefault         = !isB2B && !isAudit
const pageHeaderRaw     = isDefault ? lander.acf?.page_header : null
const pageHeader        = pageHeaderRaw ? {
  layoutContent : transformKeys(pageHeaderRaw.layout__content || pageHeaderRaw),
  layoutSettings: transformKeys(pageHeaderRaw.layout__settings || {}),
} : null
const flexibleLayouts   = isDefault ? lander.acf?.layouts || [] : []

---
<Layout
    seo={seo}
    favicon={favicon}
    headerColor={headerColor}
    accentColor={accentColor}
    secondaryColor={secondaryColor}
    headerPosition={headerPosition}
    b2bHeader={isB2B}
>
    {isB2B && 
        <PPCLanderWrapperCMO acf={lander.acf} />
    }
    {aiAudit &&
        <AuditLanderWrapper acf={aiAudit} />
    }
    {pageHeader &&
        <PageHeader layoutData={pageHeader} />
    }
    {flexibleLayouts.length > 0 &&
        <FlexibleLayouts layouts={flexibleLayouts} />
    }
</Layout>