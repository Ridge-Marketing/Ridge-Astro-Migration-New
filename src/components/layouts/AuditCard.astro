---
/**
 * Audit Card layout — two-column card with text left, image right
 * Card background: #F3F1EE with rounded corners
 * Section background: black on top half, transparent on bottom half
 */
import Container from '@/components/global/Container.astro';
import Buttons from '@/components/global/Buttons.astro';
import WpImage from '@/components/global/WpImage.astro';
import { theme } from '@/lib/theme';
import { parser } from '@/lib/parser';
import { resolveImage } from '@/lib/wp-client';

interface Props {
  layoutData: {
    layoutContent: any;
    layoutSettings: any;
  };
}

const { layoutData }  = Astro.props;
const content         = layoutData.layoutContent;
const settings        = layoutData.layoutSettings;

const body            = content.body ? parser(content.body) : '';

const bullets: any[]  = content.bullets || content.bulletPoints || content.listItems || [];

const mediaImage      = content.componentFlexibleMedia?.image || content.image;
const resolved        = await resolveImage(mediaImage);
const imageUrl        = resolved?.source_url || '';
const imageAlt        = resolved?.alt_text || content.componentFlexibleMedia?.imageAlt || content.imageAlt || '';
---

<!-- Section with black top-half / transparent bottom-half split background -->
<section class="relative pb-12 lg:pb-16">
  <!-- Black covers only the top 50% of this section's height -->
  <div class="absolute inset-x-0 top-0 h-1/2 bg-black pointer-events-none"></div>

  <Container container={settings?.containerWidth || 'slim'}>
    <!-- Card sits above the split background -->
    <div class="relative rounded-2xl overflow-hidden p-12 lg:p-16" style="background-color: #F3F1EE;">
      <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[480px] gap-8 xl:gap-12">

        <!-- Left col: text content -->
        <div class="flex items-center">
          <div class="w-full">
            {content.eyebrow && (
              <p class="font-stratos uppercase text-sm font-bold tracking-widest mb-4 text-rm-green">
                {content.eyebrow}
              </p>
            )}
            {content.heading && (
              <h2 class={`${theme.text.H2}`}>{content.heading}</h2>
            )}
            {body && (
              <p set:html={body.replaceAll('<br>', '')} class={`${theme.text.P_STD} mt-6`} />
            )}

            <!-- Bullet points -->
            {bullets.length > 0 && (
              <ul class="mt-6 space-y-3">
                {bullets.map((item: any) => {
                  const label = item.text || item.bulletPoint || item.bullet || item.item || item.label || '';
                  return (
                    <li class={`${theme.text.P_STD} flex items-start gap-3`}>
                      <span class="mt-[6px] flex-shrink-0 w-[10px] h-[10px] rounded-full bg-rm-green" aria-hidden="true"></span>
                      <span>{label}</span>
                    </li>
                  );
                })}
              </ul>
            )}

            {content.componentButton?.link && (
              <div class="mt-8">
                <Buttons
                  content={content.componentButton}
                  sectionBackground="paleGrey"
                />
              </div>
            )}
          </div>
        </div>

        <!-- Right col: image -->
        <div class="relative min-h-[320px] lg:min-h-0">
          {imageUrl ? (
            <WpImage
              src={imageUrl}
              alt={imageAlt}
              class="w-full h-full object-contain absolute inset-0"
            />
          ) : (
            <div class="w-full h-full bg-[#E0DDD9] absolute inset-0" />
          )}
        </div>

      </div>
    </div>
  </Container>
</section>
