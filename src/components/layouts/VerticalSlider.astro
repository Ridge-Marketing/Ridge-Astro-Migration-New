---
/**
 * Vertical Slider layout — picks the variant, same as Gatsby's VerticalSlider.js:
 *   style_toggle on  → VerticalSliderStyleToggle (sticky floor-by-floor media)
 *   style_toggle off → VerticalSliderDefault (numbered list + Lottie)
 */
import VerticalSliderDefault from './VerticalSliderDefault.astro';
import VerticalSliderStyleToggle from './VerticalSliderStyleToggle.astro';

interface Props {
  layoutData: {
    layoutContent: any;
    layoutSettings: any;
  };
}

const { layoutData } = Astro.props;
const styleToggle    = layoutData.layoutContent?.styleToggle ?? false;
---

{styleToggle
  ? <VerticalSliderStyleToggle layoutData={layoutData} />
  : <VerticalSliderDefault layoutData={layoutData} />}
