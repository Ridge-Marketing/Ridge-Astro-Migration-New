---
/**
 * Results Mixed layout
 * Heading + body above a list of result entries.
 * Each result renders inline mixed content: "description" pieces in normal text
 * and "stat" pieces in large accent text, all baseline-aligned.
 *
 * ACF fields (layout__content):
 *   heading    – section heading
 *   body       – section body paragraph
 *   results[]  – array of:
 *     content[] – { style: "description" | "stat", text }
 *     link      – { title, url, target }
 */
import Section from '@/components/global/Section.astro';
import Container from '@/components/global/Container.astro';
import { theme } from '@/lib/theme';
import { parser } from '@/lib/parser';

interface Props {
  layoutData: {
    layoutContent: any;
    layoutSettings: any;
  };
}

const { layoutData } = Astro.props;
const content = layoutData.layoutContent || {};
const settings = layoutData.layoutSettings || {};

const results  = content.results || [];
const textColor = settings.backgroundColor === 'black' ? 'text-white' : '';
---

<Section settings={settings}>
  <Container container={settings.containerWidth}>

    {(content.heading || content.body) && (
      <div class="mb-12">
        {content.heading && (
          <h2
            class={`${theme.text.H2} ${textColor} mb-6`}
            set:html={parser(content.heading)}
          />
        )}
        {content.body && (
          <p
            class={`${theme.text.P_STD} ${textColor}`}
            set:html={parser(content.body)}
          />
        )}
      </div>
    )}

    <div class="divide-y divide-current">
      {results.map((result: any) => {
        const pieces = result.content || [];
        return (
          <div class="py-8 lg:py-10 flex flex-col lg:flex-row lg:items-end lg:justify-between lg:gap-12">

            <!-- Mixed inline content -->
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              {pieces.map((piece: any) =>
                piece.style === 'stat' ? (
                  <span class={`accent-text font-stratos font-semibold text-80px lg:text-100px leading-none`}>
                    {piece.text}
                  </span>
                ) : (
                  <span class={`${theme.text.P_STD} ${textColor}`}>
                    {piece.text}
                  </span>
                )
              )}
            </div>

            <!-- Case study link -->
            {result.link?.url && (
              <a
                href={result.link.url}
                target={result.link.target || undefined}
                class={`${theme.text_links.BASE_STYLING} ${theme.text_links.STD} ${theme.text_links.FWD_BASE} ${theme.text_links.ARW_FWD_GREEN} text-rm-green mt-4 lg:mt-0 shrink-0`}
              >
                {result.link.title || 'VIEW CASE STUDY'}
              </a>
            )}

          </div>
        );
      })}
    </div>

  </Container>
</Section>
