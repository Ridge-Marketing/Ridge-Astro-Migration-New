---
/**
 * Results Mixed layout — centered heading/body above a row of result
 * columns (31% each on desktop). Each column stacks its pieces as blocks —
 * stats as green H2, descriptions as H4 — with a link pinned to the bottom.
 * Replaces Gatsby's ResultsMixed.js
 *
 * ACF fields (layout__content):
 *   heading, body – section intro
 *   results[]     – { content[]: { style: "stat" | "description", text }, link: { title, url, target } }
 */
import Section from '@/components/global/Section.astro';
import Container from '@/components/global/Container.astro';
import { theme } from '@/lib/theme';
import { convertCMSLink } from '@/lib/wp-client';

interface Props {
  layoutData: {
    layoutContent: any;
    layoutSettings: any;
  };
}

const { layoutData } = Astro.props;
const content        = layoutData.layoutContent || {};
const settings       = layoutData.layoutSettings || {};

const textColor = settings.backgroundColor === 'black' ? 'text-rm-white' : 'text-rm-black';
const results   = content.results || [];
const linkClass = `${theme.text_links.BASE_STYLING}${theme.text_links.FWD_BASE}${theme.text_links.STD}${theme.text_links.ARW_FWD_BLACK}${theme.text_links.HOVER_GREEN}${theme.text_links.HOVER_ARW_FWD_GREEN}mt-12`;
---

<Section settings={settings}>
  <Container>
    {content.heading && (
      <h2 class={`${theme.text.H2} mb-9 text-center ${textColor}`}>{content.heading}</h2>
    )}
    {content.body && (
      <p class={`${theme.text.P_STD} text-center ${textColor}`}>{content.body}</p>
    )}
    <div class="mt-12 flex w-full flex-wrap justify-between">
      {results.map((result: any) => (
        <div class="flex flex-col w-full small lg:w-[31%] justify-between">
          <p>
            {(result.content || []).map((piece: any) => (
              <span class={`${piece.style === 'stat' ? `${theme.text.H2} text-rm-green` : `${theme.text.H4} text-rm-black`} mb-1 block`}>
                {piece.text}
              </span>
            ))}
          </p>
          {result.link?.url && (
            <a
              href={convertCMSLink(result.link.url)}
              target={result.link.target === '_blank' ? '_blank' : undefined}
              rel={result.link.target === '_blank' ? 'noopener noreferrer' : undefined}
              class={linkClass}
            >
              {result.link.title}
            </a>
          )}
        </div>
      ))}
    </div>
  </Container>
</Section>
