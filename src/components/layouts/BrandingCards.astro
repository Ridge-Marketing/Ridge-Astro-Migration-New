---
/**
 * Branding Cards layout — white heading over a 280px black band, then a
 * centered wrap of white logo cards (max 320px × 200px, brandcard shadow),
 * an optional bottom heading and button.
 * Replaces Gatsby's BrandingCards.js
 *
 * ACF fields (layout__content):
 *   heading            – section heading
 *   cards[]            – { image (media ID), image_padding_top, image_padding_bottom }
 *                        padding: "24_pixels" | "32_pixels" | "48_pixels" (default 48)
 *   bottom_heading     – optional heading below the cards
 *   component__button  – optional CTA button
 */
import Section from '@/components/global/Section.astro';
import Container from '@/components/global/Container.astro';
import Buttons from '@/components/global/Buttons.astro';
import { theme } from '@/lib/theme';
import { resolveImage } from '@/lib/wp-client';

interface Props {
  layoutData: {
    layoutContent: any;
    layoutSettings: any;
  };
}

const { layoutData } = Astro.props;
const content        = layoutData.layoutContent || {};
const settings       = layoutData.layoutSettings || {};

const paddingTopMap: Record<string, string> = {
  '24_pixels': 'pt-6',
  '32_pixels': 'pt-8',
  '48_pixels': 'pt-12',
};

const paddingBottomMap: Record<string, string> = {
  '24_pixels': 'pb-6',
  '32_pixels': 'pb-8',
  '48_pixels': 'pb-12',
};

const cards = await Promise.all(
  (content.cards || []).map(async (card: any) => ({
    image: await resolveImage(card.image),
    pt   : paddingTopMap[card.imagePaddingTop] || 'pt-12',
    pb   : paddingBottomMap[card.imagePaddingBottom] || 'pb-12',
  }))
);
---

<Section classes="relative" settings={settings}>
  <div class="absolute top-0 h-[280px] bg-black w-full"></div>
  <Container container={settings.containerWidth}>
    {content.heading && (
      <p class={`${theme.text.H2} text-center text-white relative`}>{content.heading}</p>
    )}

    <div class="flex flex-wrap gap-x-7 gap-y-16 py-24 justify-center relative">
      {cards.map((card) => (
        <div class="bg-white max-w-[320px] w-full shadow-brandcard flex justify-center items-center h-[200px]">
          {card.image?.source_url && (
            <img
              class={`${card.pt} ${card.pb} px-10 object-contain max-h-full`}
              src={card.image.source_url}
              alt={card.image.alt_text || ''}
              loading="lazy"
            />
          )}
        </div>
      ))}
    </div>

    {content.bottomHeading && (
      <p class={`${theme.text.H5} text-center`}>{content.bottomHeading}</p>
    )}
    {content.componentButton?.link && (
      <div class={`text-center pt-4 ${content.bottomHeading ? 'mt-10' : ''}`}>
        <Buttons content={content.componentButton} sectionBackground={settings.backgroundColor} />
      </div>
    )}
  </Container>
</Section>
