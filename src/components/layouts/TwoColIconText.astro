---
/**
 * Two Column Icon + Text layout — 2-column grid of items, each with an icon,
 * H2 title, text, H4 list title and a bulleted list. Centered on mobile,
 * left-aligned on desktop.
 * Replaces Gatsby's TwoColIconText.js
 *
 * ACF fields (layout__content):
 *   items[] – { image (media ID), title, text, list_title, list[]: { list_item } }
 */
import Section from '@/components/global/Section.astro';
import Container from '@/components/global/Container.astro';
import WpImage from '@/components/global/WpImage.astro';
import { theme } from '@/lib/theme';
import { parser } from '@/lib/parser';
import { resolveImage } from '@/lib/wp-client';

interface Props {
  layoutData: {
    layoutContent: any;
    layoutSettings: any;
  };
}

const { layoutData } = Astro.props;
const content        = layoutData.layoutContent || {};
const settings       = layoutData.layoutSettings || {};

const items = await Promise.all(
  (content.items || []).map(async (item: any) => ({
    ...item,
    image: await resolveImage(item.image),
  }))
);
---

<Section settings={settings}>
  <Container container={settings.containerWidth}>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-12">
      {items.map((item: any) => (
        <div class="flex flex-col">
          {item.image?.source_url && (
            <div class="mb-6 relative w-24 h-auto mx-auto lg:mx-0">
              {item.image.source_url.endsWith('.svg') || !item.image.width ? (
                <img src={item.image.source_url} alt={item.image.alt_text || ''} class="w-full h-auto object-contain" loading="lazy" />
              ) : (
                <WpImage
                  src={item.image.source_url}
                  alt={item.image.alt_text || ''}
                  width={item.image.width}
                  height={item.image.height}
                  responsive
                  sizes="96px"
                  class="w-full h-auto object-contain"
                />
              )}
            </div>
          )}

          {item.title && (
            <h3 class={`${theme.text.H2} text-center lg:text-left mb-4`}>{item.title}</h3>
          )}

          {item.text && (
            <p class={`${theme.text.P_STD} text-center lg:text-left mb-6`}>
              <span set:html={parser(item.text)} />
            </p>
          )}

          {item.listTitle && (
            <h4 class={`${theme.text.H4} text-center lg:text-left mb-3`}>{item.listTitle}</h4>
          )}

          {item.list?.length > 0 && (
            <div>
              <ul class="list-disc space-y-3 pt-2">
                {item.list.map((entry: any) => (
                  <li class={`${theme.text.P_STD} flex items-start gap-3`}>
                    <span class="mr-1">•</span>
                    <span>{entry.listItem}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>
  </Container>
</Section>
