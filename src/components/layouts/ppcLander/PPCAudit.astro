---
/**
 * PPC Audit — pale card with text/list/CTA left, image right.
 * Replaces Gatsby's ppcLander/PpcAudit.js
 */
import Container from '@/components/global/Container.astro'
import WpImage from '@/components/global/WpImage.astro'
import parser from '@/lib/parser'
import { theme } from '@/lib/theme'
import { resolveImage } from '@/lib/wp-client'

interface Props {
    acf : {
        heading           : string,
        sub_heading       : string,
        body              : string,
        list              : any[],
        component__button : any,
        image             : number
    }
}

const { acf } = Astro.props
const heading         = acf.heading ?? false
const subHeading      = acf.sub_heading ?? false
const body            = acf.body ?? false
const list            = acf.list ?? false
const componentButton = acf.component__button ?? false

const resolved = await resolveImage(acf.image)
const imageUrl = resolved?.source_url || ''
const imageAlt = resolved?.alt_text || ''
---

<section class="py-20 xl:pb-40">
    <Container container="default">
        <div class="bg-[#F3F1EE] rounded-[21px] overflow-hidden flex flex-col xl:flex-row gap-8 xl:gap-12 p-8 md:p-12 xl:p-16">

            <div class="flex flex-col gap-5 xl:w-1/2">
                {heading &&
                    <h2
                        set:html={parser(heading)}
                        class={`${theme.text.H5} text-black text-center md:text-left`}
                    />
                }
                {subHeading &&
                    <p
                        set:html={parser(subHeading)}
                        class={`${theme.text.H4} text-black mb-8 text-center md:text-left`}
                    />
                }
                {body &&
                    <div
                        set:html={parser(body)}
                        class="font-basic-sans text-[1.3125rem] leading-[2rem] text-black xl:max-w-[535px] text-center md:text-left"
                    />
                }
                {list && list.length > 0 &&
                    <ul class="flex flex-col gap-4 mt-2 mb-6">
                        {list.map((item: any) => (
                            <li class="flex items-center gap-3 font-basic-sans font-semibold text-[1.375rem] leading-[1.4rem]">
                                <svg class="w-[24px] shrink-0" viewBox="0 0 24 24" fill="none">
                                    <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="#1F9DA5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <span class="text-black">{item.item}</span>
                            </li>
                        ))}
                    </ul>
                }
                {componentButton?.link?.url &&
                    <a
                        class={`${theme.button.BASE_STYLING} ${theme.button.SOLID_GREEN_HOVER_DARK} ${theme.text_links.FWD_BASE} ${theme.text_links.ARW_FWD_BLACK} ${theme.text_links.HOVER_ARW_FWD_WHITE} !inline-flex items-center cursor-pointer min-w-[210px] w-max`}
                        href={componentButton.link.url}
                    >
                        {componentButton.link.title}
                    </a>
                }
            </div>

            <div class="xl:w-1/2 flex items-center justify-center">
                {imageUrl &&
                    <WpImage src={imageUrl} alt={imageAlt} class="w-full rounded-xl object-contain" />
                }
            </div>
        </div>
    </Container>
</section>
