---
/**
 * PostCards layout — displays recent blog posts matching taxonomy
 * Replaces Gatsby's PostCards.js layout
 */
import Section from '@/components/global/Section.astro';
import Container from '@/components/global/Container.astro';
import BlogCardHome from '@/components/blog/BlogCardHome.astro';
import { getPosts, resolveImage, extractPath, postPath } from '@/lib/wp-client';
import { theme } from '@/lib/theme';

interface Props {
  layoutData: {
    layoutContent: any;
    layoutSettings: any;
  };
}

const { layoutData } = Astro.props;
const content = layoutData.layoutContent;
const settings = layoutData.layoutSettings;

// Gatsby: take the 3 newest public posts — or, when the block's first
// category is "AI", the 3 newest AI posts (its allWpPostAI query) — and show
// those in one of the block's categories, in taxonomy order.
// The ACF taxonomy field is category IDs over REST (`[4448]`), not the
// { id, name } objects GraphQL returned; matching on .name found nothing, so
// every block showed the newest 3 posts. Accept either shape and match by ID.
const taxonomyIds = ((content.taxonomy || []) as any[])
  .map((t) => (typeof t === 'object' && t ? t.id ?? t.term_id : t))
  .map(Number)
  .filter(Boolean);
const allPosts    = await getPosts();
const termsOf     = (p: any): Array<{ id: number; name: string }> => p._embedded?.['wp:term']?.[0] || [];
const termName    = (id: number) => {
  for (const p of allPosts) {
    const term = termsOf(p).find((t) => t.id === id);
    if (term) return term.name;
  }
  return '';
};
const aiOnly      = taxonomyIds.length > 0 && termName(taxonomyIds[0]) === 'AI';
const posts       = allPosts
  .filter((p: any) => {
    const fields = p.acf?.additional_blog_fields || p.acf?.additionalBlogFields || {};
    return !fields.preview_mode && !fields.previewMode;
  })
  .filter((p: any) => !aiOnly || termsOf(p).some((t) => t.name === 'AI'))
  .slice(0, 3);

const cards: any[] = [];
for (const id of taxonomyIds) {
  for (const post of posts) {
    if (cards.length < 3 && !cards.includes(post) && termsOf(post).some((t) => t.id === id)) {
      cards.push(post);
    }
  }
}

// If no taxonomy match, fall back to first 3 posts
const displayCards = cards.length > 0 ? cards : posts.slice(0, 3);

// Resolve images for each card
const resolvedCards = await Promise.all(
  displayCards.map(async (post: any) => {
    const blogFields = post.acf?.additional_blog_fields || post.acf?.additionalBlogFields || {};
    const squareImage = blogFields.square_image || blogFields.squareImage;
    const featuredMedia = post._embedded?.['wp:featuredmedia']?.[0];

    // Prefer square image, fall back to featured image
    let resolved = null;
    if (squareImage) {
      resolved = await resolveImage(squareImage);
    }
    if (!resolved && featuredMedia) {
      resolved = {
        source_url: featuredMedia.source_url,
        alt_text: featuredMedia.alt_text || '',
      };
    }

    return {
      title   : post.title?.rendered || '',
      link    : postPath(post),
      imageSrc: resolved?.source_url || '',
      // Gatsby used the featured image's alt even when showing the square
      // image; prefer the square image's own alt, then fall back to that
      imageAlt: resolved?.alt_text || featuredMedia?.alt_text || '',
    };
  })
);
---

<Section settings={settings}>
  <Container>
    {content.heading && (
      <h2 class={`${theme.text.H2}text-center`}>
        {content.heading}
      </h2>
    )}
    {content.body && (
      <p class={`${theme.text.P_STD}mt-6 text-center`}>
        {content.body}
      </p>
    )}
    <div>
      <div class="mt-12 flex w-full flex-col items-center lg:items-stretch justify-between lg:flex-row lg:flex-wrap lg:justify-between">
        {resolvedCards.map((card) => (
          <BlogCardHome
            heading={card.title}
            link={card.link}
            imageSrc={card.imageSrc}
            imageAlt={card.imageAlt}
          />
        ))}
      </div>
    </div>
  </Container>
</Section>
