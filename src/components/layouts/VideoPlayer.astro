---
/**
 * Video Player layout — main vimeo player with optional thumbnail row.
 * Replaces Gatsby's VideoPlayer.js
 */
import Section from '@/components/global/Section.astro';
import Container from '@/components/global/Container.astro';
import { theme } from '@/lib/theme';
import { resolveImage } from '@/lib/wp-client';
import { vimeoEmbedUrl, getVimeoThumbnail } from '@/lib/vimeo';
import PlayIcon from '@/components/global/PlayIcon.astro';

interface Props {
  layoutData: {
    layoutContent: any;
    layoutSettings: any;
  };
}

const { layoutData } = Astro.props;
const content   = layoutData.layoutContent  || {};
const settings  = layoutData.layoutSettings || {};

// No placeholder in the CMS → Vimeo's own poster frame (Gatsby always
// mounted the player, which showed it; our iframe only loads on click).
// Autoplaying videos load straight away, so they don't need one.
const videos = await Promise.all(
  (content.videos || []).map(async (v: any) => {
    const placeholder = await resolveImage(v.placeholder);
    const vimeoThumb  = placeholder?.source_url || v.autoplay ? null : await getVimeoThumbnail(v.source);
    return {
      source     : v.source || '',
      caption    : v.caption || '',
      autoplay   : !!v.autoplay,
      placeholder: placeholder?.source_url
        ? placeholder
        : vimeoThumb && { source_url: vimeoThumb.url, alt_text: vimeoThumb.title, width: vimeoThumb.width, height: vimeoThumb.height },
    };
  })
);

// Player URL (keeps the ?h= privacy hash unlisted videos need); autoplaying
// videos play muted, looped, without controls. The rest only load on click,
// so they start playing straight away (Gatsby: one click to play)
function vimeoEmbed(url: string, autoplay = false): string {
  const params: Record<string, number> = autoplay ? { autoplay: 1, muted: 1, loop: 1, controls: 0 } : { autoplay: 1 };
  return vimeoEmbedUrl(url, params) || url;
}

const main = videos[0];
const thumbs = videos.slice(0, 3); // matches "if (index < 3)" cap
---

<Section settings={settings}>
  <Container>
    {content.heading && (
      <h2 class={`${theme.text.H2} text-center mb-8`}>{content.heading}</h2>
    )}

    {main && (
      <div class="video-player" data-videos={JSON.stringify(videos.map((v) => ({
        source  : v.source,
        autoplay: v.autoplay,
        embed   : vimeoEmbed(v.source, v.autoplay),
      })))}>
        <div class="relative pt-[56.25%] video-player__stage">
          {main.placeholder?.source_url && (
            <img
              src={main.placeholder.source_url}
              alt={main.placeholder.alt_text || ''}
              class="absolute top-0 left-0 w-full h-full object-cover z-10 video-player__thumb"
              loading="eager"
            />
          )}
          <iframe
            src={main.autoplay ? vimeoEmbed(main.source, true) : ''}
            class={`absolute top-0 left-0 w-full h-full ${main.autoplay ? '' : 'hidden'} video-player__iframe`}
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            title="Video"
          />
          {!main.autoplay && (
            <div class="absolute top-0 left-0 w-full h-full z-30 flex flex-col items-center justify-center text-rm-white video-player__play">
              <button
                type="button"
                class="relative rounded-full shadow-none transition-shadow hover:shadow-block video-player__play-btn"
                aria-label="Play video"
              >
                <PlayIcon />
              </button>
            </div>
          )}
        </div>
        {main.caption && (
          <p class={`mt-2 ${theme.text.P_STD} max-w-[1120px] mx-auto video-player__caption`}>{main.caption}</p>
        )}

        {videos.length > 1 && (
          <div class="grid grid-cols-3 mt-4 xl:mt-9 -mx-2 xl:-mx-5">
            {thumbs.map((v, index) => (
              <div
                role="button"
                tabindex="0"
                class="relative pt-[56.25%] mx-2 xl:mx-5 cursor-pointer video-player__pick"
                data-index={index}
              >
                {v.placeholder?.source_url && (
                  <img
                    src={v.placeholder.source_url}
                    alt={v.placeholder.alt_text || ''}
                    class="absolute top-0 left-0 w-full h-full object-cover"
                    loading="lazy"
                  />
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    )}
  </Container>
</Section>

<script>
  type V = { source: string; autoplay: boolean; embed: string };

  document.querySelectorAll<HTMLElement>('.video-player').forEach((root) => {
    const raw = root.dataset.videos;
    if (!raw) return;
    let videos: V[] = [];
    try { videos = JSON.parse(raw); } catch { return; }

    const iframe  = root.querySelector<HTMLIFrameElement>('.video-player__iframe');
    const thumb   = root.querySelector<HTMLImageElement>('.video-player__thumb');
    const play    = root.querySelector<HTMLElement>('.video-player__play');
    const playBtn = root.querySelector<HTMLButtonElement>('.video-player__play-btn');
    const picks   = root.querySelectorAll<HTMLElement>('.video-player__pick');

    function loadIndex(i: number) {
      const v = videos[i];
      if (!v || !iframe) return;
      iframe.src = v.embed;
      iframe.classList.remove('hidden');
      thumb?.remove();
      play?.remove();
    }

    playBtn?.addEventListener('click', () => loadIndex(0));
    picks.forEach((p) => {
      const i = Number(p.dataset.index);
      const handler = () => loadIndex(i);
      p.addEventListener('click', handler);
      p.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); handler(); }
      });
    });
  });
</script>
