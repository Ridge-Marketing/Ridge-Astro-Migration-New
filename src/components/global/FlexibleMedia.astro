---
/**
 * FlexibleMedia — image / video (file or vimeo) / lottie media renderer.
 * Replaces Gatsby's components/global/FlexibleMedia.js.
 *
 * Data shape (after transformKeys to camelCase):
 *   { type: 'image' | 'video' | 'lottie',
 *     image, imageAlt, lottie,
 *     videoSource: 'file' | 'vimeo',
 *     video: { videoUrl, mobileVideoUrlOptional, thumbnailImage, autoplay, controls } }
 *
 * Vimeo videos render in an iframe with a click-to-play thumbnail overlay.
 * Self-hosted videos with autoplay="Yes" autoplay via IntersectionObserver
 * once 50% in view (mirrors the Gatsby behavior).
 */
import WpImage from '@/components/global/WpImage.astro';
import { theme } from '@/lib/theme';
import { resolveImage } from '@/lib/wp-client';
import { vimeoEmbedUrl, getVimeoThumbnail } from '@/lib/vimeo';
import PlayIcon from '@/components/global/PlayIcon.astro';

interface Props {
  data: any;
  paddingRatio?: string;
  className?: string;
  wrapperClassName?: string;
}

const { data, paddingRatio, className = '', wrapperClassName = '' } = Astro.props;

const type        = data?.type;
const ratio       = paddingRatio || '56.25%';

const isImage     = type === 'image';
const isVideo     = type === 'video';
const isLottie    = type === 'lottie';

const imageData   = isImage ? await resolveImage(data.image) : null;
const imageAlt    = data?.imageAlt || imageData?.alt_text || '';

const video       = isVideo ? data.video : null;
const videoSource = isVideo ? data.videoSource : null;
const isFileVideo = isVideo && videoSource === 'file';
const isVimeo     = isVideo && videoSource === 'vimeo';

const thumb       = isVimeo ? await resolveImage(video?.thumbnailImage) : null;

// No thumbnail set in WP → use Vimeo's own poster frame (oEmbed, build time).
// If that's unavailable too, load the player right away like Gatsby did, so
// the box is never empty.
const vimeoThumb  = isVimeo && !thumb?.source_url ? await getVimeoThumbnail(video?.videoUrl) : null;
const thumbSrc    = thumb?.source_url || vimeoThumb?.url || '';
const thumbAlt    = thumb?.alt_text || vimeoThumb?.title || '';
const playerSrc   = isVimeo && !thumbSrc ? vimeoEmbedUrl(video?.videoUrl) : null;
// Unique per instance — several players can share a page
// File-video flags
const showControls  = !video || !video.controls || video.controls !== 'Hide';
const autoplay     = video?.autoplay === 'Yes';
const mobileSrc    = video?.mobileVideoUrlOptional || '';
const desktopSrc   = video?.videoUrl || '';

const lottieSrc    = isLottie ? data.lottie : '';
---

<div class={wrapperClassName}>
  {isImage && imageData?.source_url && (
    <div>
      <WpImage src={imageData.source_url} alt={imageAlt} class={className} />
    </div>
  )}

  {isLottie && lottieSrc && (
    <div>
      <div
        class="flexible-media-lottie"
        data-lottie-src={lottieSrc}
        style="height:auto;width:100%;"
      />
    </div>
  )}

  {isFileVideo && (
    <div>
      {mobileSrc && (
        <video
          preload="metadata"
          class="md:hidden w-full z-0 flexible-media-video"
          data-autoplay={autoplay ? 'true' : 'false'}
          controls={showControls}
          muted={autoplay}
          loop={autoplay}
          playsinline
        >
          <source src={mobileSrc} type="video/mp4" />
        </video>
      )}
      <video
        preload="metadata"
        class={`${mobileSrc ? 'hidden md:block' : ''} w-full z-0 flexible-media-video`}
        data-autoplay={autoplay ? 'true' : 'false'}
        controls={showControls}
        autoplay={autoplay}
        muted={autoplay}
        loop={autoplay}
        playsinline
      >
        <source src={desktopSrc} type="video/mp4" />
      </video>
    </div>
  )}

  {isVimeo && video?.videoUrl && (
    <>
      <div
        class="w-full relative media-video flexible-media-vimeo"
        style={`padding-top:${ratio};`}
        data-vimeo-url={video.videoUrl}
      >
        {thumbSrc && (
          <div class="absolute top-0 left-0 w-full h-full z-30 flex flex-col items-center justify-center flexible-media-vimeo-thumb">
            <img
              src={thumbSrc}
              alt={thumbAlt}
              class="absolute top-0 left-0 w-full h-full object-cover"
              loading="eager"
            />
          </div>
        )}
        {playerSrc ? (
          <iframe
            src={playerSrc}
            class="absolute top-0 left-0 w-full h-full"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
            title={thumbAlt || 'Video'}
          />
        ) : (
        <!-- Gatsby's Play icon (components/svg.js) in its white, round,
             shadow-on-hover button -->
        <div class="absolute top-0 left-0 w-full h-full z-40 flex flex-col items-center justify-center text-rm-white flexible-media-play-wrap">
          <button
            type="button"
            class="relative rounded-full shadow-none transition-shadow hover:shadow-block flexible-media-play"
            aria-label="Play video"
          >
            <PlayIcon />
          </button>
        </div>
        )}
      </div>
      {data.caption && (
        <p class={`mt-2 ${theme.text.P_STD} max-w-[1120px] mx-auto`}>{data.caption}</p>
      )}
    </>
  )}
</div>

<script>
  import { vimeoEmbedUrl } from '@/lib/vimeo';
  import lottie from 'lottie-web';

  // Lottie animations
  document.querySelectorAll<HTMLElement>('.flexible-media-lottie').forEach((el) => {
    const path = el.dataset.lottieSrc;
    if (!path) return;
    lottie.loadAnimation({
      container: el,
      renderer: 'svg',
      loop: true,
      autoplay: true,
      path,
    });
  });

  // Mobile/in-view autoplay for self-hosted videos
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const v = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) v.play().catch(() => {});
      });
    }, { threshold: 0.5 });
    document.querySelectorAll<HTMLVideoElement>('.flexible-media-video[data-autoplay="true"]').forEach((v) => {
      io.observe(v);
    });
  }

  // Vimeo: swap to iframe on click
  document.querySelectorAll<HTMLElement>('.flexible-media-vimeo').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('.flexible-media-play');
    const url = root.dataset.vimeoUrl;
    if (!button || !url) return;
    button.addEventListener('click', () => {
      // Player URL with autoplay; keeps the ?h= privacy hash unlisted videos need
      const embed = vimeoEmbedUrl(url, { autoplay: 1 }) || url;
      const iframe = document.createElement('iframe');
      iframe.src = embed;
      iframe.className = 'absolute top-0 left-0 w-full h-full';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.setAttribute('allowfullscreen', '');
      const thumb = root.querySelector('.flexible-media-vimeo-thumb');
      thumb?.remove();
      root.querySelector('.flexible-media-play-wrap')?.remove();
      root.appendChild(iframe);
    });
  });
</script>
