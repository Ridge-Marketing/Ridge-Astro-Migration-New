---
/**
 * WpImage — wrapper around Astro's <Image> for WordPress images
 * Handles source_url → <Image> with inferSize, responsive widths,
 * and format negotiation via Netlify CDN.
 *
 * When inferSize fails for a remote image, falls back to a plain <img> tag.
 *
 * Usage:
 *   <WpImage src={imageData.source_url} alt={imageData.alt_text} />
 *   <WpImage src={imageData.source_url} alt="..." width={800} height={600} />
 *   <WpImage src={imageData.source_url} alt="..." responsive />
 *   <WpImage src={hero.source_url} alt="..." fetchPriority="high" />  (LCP images; also defaults loading to eager)
 */
import { Image } from 'astro:assets';
import { getRemoteSize } from '@/lib/remote-size';

interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
  responsive?: boolean;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  quality?: number | 'low' | 'mid' | 'high' | 'max';
  fetchPriority?: 'high' | 'low' | 'auto';
  style?: string;
  divHeight?: string;
  /** Inline onload handler for the main image (e.g. fade in, drop a skeleton) */
  onload?: string;
}

const {
  src,
  alt = '',
  width,
  height,
  class: className = '',
  responsive = false,
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 1200px',
  loading: loadingProp,
  quality = 80,
  fetchPriority,
  style,
  divHeight = '',
  onload
} = Astro.props;

// A high-priority image is meant to load right away, so don't lazy-load it
// unless the caller explicitly asks to
const loading = loadingProp ?? (fetchPriority === 'high' ? 'eager' : 'lazy');

// Skip if no src provided
if (!src) return;

// Determine if we should use inferSize (when no explicit dimensions provided)
const useInferSize = !width || !height;

// Everything else is served as WebP. SVGs (vector) and GIFs (may be animated)
// would be rasterized/flattened by that, so they render as-is.
const passThrough = /\.(svg|gif)(\?|$)/i.test(src);

// Measure remote images ourselves (cached + retried) instead of letting
// <Image inferSize> do it — one rate-limited fetch there fails the whole build.
// If measuring still fails, fall back to a plain <img>.
const size      = useInferSize && !passThrough ? await getRemoteSize(src) : { width, height };
const imgWidth  = size?.width;
const imgHeight = size?.height;
const sized     = !passThrough && !!(imgWidth && imgHeight);

// Blur placeholder: 32px wide (~1 KB) and stretched by CSS — the blur hides
// the upscaling. Rendering it at full size, even at quality 1, was ~130 KB.
const placeholderWidth  = 32;
const placeholderHeight = sized ? Math.max(1, Math.round((placeholderWidth * imgHeight!) / imgWidth!)) : 0;

---

{!sized ? (
  <img src={src} alt={alt} class={className} style={style} loading={loading} fetchpriority={fetchPriority} onload={onload} />
) : responsive ? (<>
  <Image
    src={src}
    alt={alt}
    widths={[400, 800, 1200, 1600]}
    sizes={sizes}
    width={imgWidth}
    height={imgHeight}
    class={className}
    loading={loading}
    fetchpriority={fetchPriority}
    style={style}
    quality={quality}
    format="webp"
    onload={onload}
  />
</>) : useInferSize ? (<>
  <div class={`relative overflow-hidden ${divHeight}`}>
    {/* Blurred low-quality placeholder; the main image removes it once it has
        loaded, so it can't show through transparent PNGs as a drop shadow.
        Eager on purpose: it's tiny and has to be there before the main image —
        <Image> defaults to lazy, so loading must be explicit. w-full/h-full
        stretch the 32px file over the main image's box */}
    <Image
      src={src}
      alt=""
      aria-hidden="true"
      width={placeholderWidth}
      height={placeholderHeight}
      class={`${className} w-full h-full blur-lg absolute top-0 left-0 opacity-30`}
      loading="eager"
      quality={50}
      format="webp"
      data-wp-placeholder
    />
    <Image
      src={src}
      alt={alt}
      width={imgWidth}
      height={imgHeight}
      class={`${className} z-10 relative`}
      loading={loading}
      fetchpriority={fetchPriority}
      style={style}
      quality={quality}
      format="webp"
      onload={`this.parentElement.querySelector('[data-wp-placeholder]')?.remove();${onload || ''}`}
    />
  </div>
</>) : (
  <Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    class={className}
    loading={loading}
    fetchpriority={fetchPriority}
    style={style}
    quality={quality}
    format="webp"
    onload={onload}
  />
)}