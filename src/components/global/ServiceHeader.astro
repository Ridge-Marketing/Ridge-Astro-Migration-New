---
/**
 * Service Header — two-color heading, eyebrow, body content, optional floated image
 * Replaces the inline header from Gatsby's service.js template
 */
import Section from '@/components/global/Section.astro';
import Container from '@/components/global/Container.astro';
import WpImage from '@/components/global/WpImage.astro';
import Buttons from '@/components/global/Buttons.astro';
import { theme } from '@/lib/theme';
import { resolveImage } from '@/lib/wp-client';
import { parser } from '@/lib/parser';

interface Props {
  layoutContent: any;
  layoutSettings: any;
}

const { layoutContent: content, layoutSettings: settings } = Astro.props;

// Resolve floated image if present
const floatedImage    = await resolveImage(content.intextFloatedImage);
const floatedImageUrl = floatedImage?.source_url || '';

// Separate body content: large items render first, standard items float alongside image
const bodyContent: any[]  = content.bodyContent || [];
const floatP: any[]       = [];

if (floatedImageUrl) {
  for (const item of bodyContent) {
    if (item.textSize === 'standard') {
      floatP.push(item);
    }
  }
}

// Gatsby shows the two-column row whenever an image is set
const visibility = floatedImageUrl ? 'block' : 'hidden invisible';
---

<Section settings={settings}>
  <Container>
    {content.eyebrow && (
      <h1 class={`${theme.text.H4} block mb-4`}>
        {content.eyebrow}
      </h1>
    )}

    {content.heading?.green && content.heading?.black && (
      <h2 class="font-stratos uppercase font-bold text-50px sm:text-60px lg:text-100px leading-[3.5rem] lg:leading-[4.75rem] mb-9">
        <span class="text-rm-green lg:block" set:html={parser(content.heading.green)} />
        <span class="text-rm-black" set:html={parser(content.heading.black)}/>
      </h2>
    )}

    {bodyContent.map((item: any) => {
      if (floatP.length < 1 || item.textSize === 'large') {
        const textSize = item.textSize === 'large' ? 'H4_LTE' : 'P_STD';
        return (
          <p class={`${(theme.text as any)[textSize]} mb-9`} set:html={parser(item.body || '')} />
        );
      }
      return null;
    })}

    <!-- Text (65%) + image (30%, 5% gap), top-aligned. Gatsby used two
         inline-blocks; a flex row avoids the whitespace gap that wrapped the
         image below the text in Astro. -->
    <div class="lg:flex lg:items-start">
      <div class={`${visibility} lg:w-[65%]`}>
        {floatP.map((item: any) => (
          <p class={`${theme.text.P_STD} mb-9`}>
            {item.body}
          </p>
        ))}
        {content.componentButton && (
          <div class="text-left">
            <Buttons content={content.componentButton} sectionBackground={settings.backgroundColor} />
          </div>
        )}
      </div>

      {floatedImageUrl && (
        <div class="mb-9 max-w-[250px] lg:max-w-full lg:mb-0 lg:w-[30%] lg:ml-[5%] mt-12 lg:mt-0 shrink-0">
          <WpImage
            src={floatedImageUrl}
            alt=""
            width={floatedImage?.width}
            height={floatedImage?.height}
            responsive
            sizes="(min-width: 1024px) 30vw, 250px"
            class="w-full h-auto object-contain"
          />
        </div>
      )}
    </div>

    {content.componentButton && visibility === 'hidden invisible' && (
      <div class="text-left">
        <Buttons content={content.componentButton} sectionBackground={settings.backgroundColor} />
      </div>
    )}
  </Container>
</Section>
