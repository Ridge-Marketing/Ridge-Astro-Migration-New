---
/**
 * SEO head component — consumes Yoast REST API data (yoast_head_json)
 *
 * Yoast builds every URL on the CMS host (canonical, og:url, og:image,
 * schema @ids), so they're mapped onto the site origin here — Gatsby's Head
 * did the same. Absolute, so the uploads middleware doesn't make og:image
 * relative (crawlers need the full URL).
 */
import { decodeDeep } from '@/lib/entities';

interface Props {
  seo: any;
  favicon?: string;
}

const { seo: rawSeo, favicon } = Astro.props;

// Yoast's strings arrive HTML-encoded ("Dun &amp; Bradstreet"); Astro encodes
// again on render, so decode every string (title, descriptions, schema) first
const seo = rawSeo ? decodeDeep(rawSeo) : rawSeo;

const siteOrigin = (Astro.site?.origin || 'https://ridgemarketing.com');
const CMS_ORIGIN = /https?:\/\/(?:www\.)?cms\.ridgemarketing\.com/g;

// Records served at a path other than their WP permalink (posts → /blog/)
// are moved before they get here — see postSeo() in wp-client.ts
const toSite     = (url?: string) => url ? url.replace(CMS_ORIGIN, siteOrigin) : url;

const canonical  = toSite(seo?.canonical);
const ogUrl      = toSite(seo?.og_url) || canonical;
// Social card image. Pages with no Yoast social image (home, privacy,
// barn-of-brands…) fall back to the barn illustration — already the most-used
// one — so shared links never render as a bare text card. Set a page's own in
// Yoast → Social; a site default in Yoast → Settings → Site basics also wins
// over this. twitter:image falls back to the og:image.
const DEFAULT_OG = {
  url   : 'https://cms.ridgemarketing.com/wp-content/uploads/2023/09/Barn-Badge.svg',
  width : 254,
  height: 254,
  alt   : 'Ridge Marketing’s badge, barn of brands',
};
const yoastOg    = seo?.og_image?.[0];
const og         = yoastOg?.url ? yoastOg : seo?.title ? DEFAULT_OG : null;
const ogImage    = toSite(og?.url);
const ogImageAlt = og?.alt || seo?.og_title || seo?.title || '';
const twImage    = toSite(seo?.twitter_image) || ogImage;

// JSON-LD from Yoast, on the site origin; "<" escaped so content can't close the tag
const schema     = seo?.schema
  ? toSite(JSON.stringify(seo.schema))!.replace(/</g, '\\u003c')
  : null;
---

{seo?.title && <title>{seo.title}</title>}
{favicon && <link rel="icon" type="image/x-icon" href={favicon} />}
{canonical && <link rel="canonical" href={canonical} />}

<meta name="description" content={seo?.description || seo?.og_description || ''} />
{seo?.title && <meta name="title" content={seo.title} />}
{seo?.robots?.index === 'noindex' && (
  <>
    <meta name="robots" content="noindex" />
    <meta name="googlebot-news" content="noindex" />
  </>
)}
{seo?.robots?.follow === 'nofollow' && (
  <meta name="robots" content="nofollow" />
)}

<!-- Open Graph -->
<meta property="og:type" content={seo?.og_type || 'website'} />
{ogUrl && <meta property="og:url" content={ogUrl} />}
{seo?.og_title && <meta property="og:title" content={seo.og_title} />}
{seo?.og_description && <meta property="og:description" content={seo.og_description} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && og?.width && <meta property="og:image:width" content={String(og.width)} />}
{ogImage && og?.height && <meta property="og:image:height" content={String(og.height)} />}
{ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

<!-- Twitter -->
<meta property="twitter:card" content={seo?.twitter_card || 'summary_large_image'} />
{ogUrl && <meta property="twitter:url" content={ogUrl} />}
{seo?.twitter_title && <meta property="twitter:title" content={seo.twitter_title} />}
{seo?.twitter_description && <meta property="twitter:description" content={seo.twitter_description} />}
{twImage && <meta property="twitter:image" content={twImage} />}
{twImage && ogImageAlt && <meta property="twitter:image:alt" content={ogImageAlt} />}

<!-- Structured data -->
{schema && <script type="application/ld+json" set:html={schema} />}
