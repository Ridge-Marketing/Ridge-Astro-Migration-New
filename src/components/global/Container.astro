---
/**
 * Container wrapper — constrained-width content container
 * Replaces the Container export from Gatsby's Wrappers.js
 */
interface Props {
  container?: string;
  classes?: string;
}

const { container = 'slim', classes = '' } = Astro.props;

const sizes: Record<string, string> = {
  default: 'container mx-auto',
  slim: 'container xl:!max-w-[1224px] mx-auto',
  // `!` is a leftover from the old unlayered .container rule; harmless now that
  // container is a layered @utility (see "Container" in CLAUDE.md)
  mini: 'container lg:!max-w-[750px] xl:!max-w-[930px] mx-auto',
  none: '',
};

const containerClass = sizes[container] ?? sizes['slim'];
---

<div class={`${containerClass} relative ${classes} px-4`}>
  <slot />
</div>
