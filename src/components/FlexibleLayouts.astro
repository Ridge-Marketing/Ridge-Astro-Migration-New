import ResultsTextBlock from './layouts/ResultsTextBlock.astro';
import BrandingCards from './layouts/BrandingCards.astro';
import TwoColImageList from './layouts/TwoColImageList.astro';
import TwoColIconText from './layouts/TwoColIconText.astro';
import ResultsMixed from './layouts/ResultsMixed.astro';
import VerticalSlider from './layouts/VerticalSlider.astro';
import AuditCard from './layouts/AuditCard.astro';
import ProjectPortfolio from './layouts/ProjectPortfolio.astro';
import MediaBlocks from './layouts/MediaBlocks.astro';
import VideoPlayer from './layouts/VideoPlayer.astro';
import TextVideoOverhang from './layouts/TextVideoOverhang.astro';
