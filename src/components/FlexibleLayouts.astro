import CtaFooterPpc from './layouts/CtaFooterPpc.astro';
import TwoColTextForm from './layouts/TwoColTextForm.astro';

// Phase 6 layout components (PPC/audit pages)
import AuditStats from './layouts/AuditStats.astro';
import TwoColContentPpc from './layouts/TwoColContentPpc.astro';
import TwoColTextQuoteCard from './layouts/TwoColTextQuoteCard.astro';
import StepsWithImages from './layouts/StepsWithImages.astro';
import StepsWithCard from './layouts/StepsWithCard.astro';
import PpcProjectSlider from './layouts/PpcProjectSliderWrapper.astro';
import PpcForm from './layouts/PpcForm.astro';
import FullWidthImageGallery from './layouts/FullWidthImageGallery.astro';
import ExpandableIconBoxes from './layouts/ExpandableIconBoxes.astro';
import BulletsWithImage from './layouts/BulletsWithImage.astro';

// Layouts added on Gatsby Jul–Aug 2026 (Home Page 2026 + B2B AI service)
import TwoColTextText from './layouts/TwoColTextText.astro';
import TwoColTextList from './layouts/TwoColTextList.astro';
import FullWidthVideoText from './layouts/FullWidthVideoText.astro';
import CaseStudies from './layouts/CaseStudies.astro';
import FeaturedCampaigns from './layouts/FeaturedCampaigns.astro';
import BarnOfBrands from './layouts/BarnOfBrands.astro';
import LogoCarousel from './layouts/LogoCarousel.astro';

const layoutComponents: Record<string, any> = {
  TwoColImageText,
  TextBlock,
  FullWidthImage,
  PageHeader,
  HomeHero,
  IconTextBoxes,
  LogoCloud,
  Quotes,
  LineBreak,
  PostCards,
  Results,
  ButtonRow,
  FeaturedProjectsCarousel,
  FeaturedProjectsGridDev,
  FullWidthImageText,
  FullWidthImageVideoText,
  FrequentlyAskedQuestions,
  CtaForm,
  CareersForm,
  ContactFourSquare,
  ProjectBlocks,
  FlexibleProjectBlocks,
  TwoColBreakoutImageText,
  TwoColBreakoutImageHeading,
  TeamGrid,
  QuarterImageText,
  TwoColTextQuote,
  ResultsTextBlock,
  BrandingCards,
  TwoColImageList,
  TwoColIconText,
  ResultsMixed,
  VerticalSlider,
  AuditCard,
  ProjectPortfolio,
  MediaBlocks,
  VideoPlayer,
  TextVideoOverhang,
  ImagesTopAlignedText,
  PullquoteImage,
  ResultsImage,
  ImageCarousel,
  CtaFooterPpc,
  TwoColTextForm,
  AuditStats,
  TwoColContentPpc,
  TwoColTextQuoteCard,
  StepsWithImages,
  StepsWithCard,
  PpcProjectSlider,
  PpcForm,
  FullWidthImageGallery,
  ExpandableIconBoxes,
  BulletsWithImage,
  TwoColTextText,
  TwoColTextList,
  FullWidthVideoText,
  CaseStudies,
  FeaturedCampaigns,
  BarnOfBrands,
  LogoCarousel,
};

interface Props {
  layouts: any[];
}

const { layouts } = Astro.props;

/**
 * Extract layoutContent and layoutSettings from a REST API layout block.
 *
 * REST API ACF flexible content blocks have the shape:
 * {
 *   acf_fc_layout: "text_block",
 *   layout__text_block: {
 *     layout__content: { ... },
 *     layout__settings: { ... }
 *   }
 * }
 *
 * We extract the nested content/settings and transform keys to camelCase
 * so components receive { layoutContent: { headingStyle, ... }, layoutSettings: { backgroundColor, ... } }.
 */
function extractLayoutData(block: any) {
  const layoutName = block.acf_fc_layout;

  // Try to find the nested layout data under layout__<name>
  // Also try a normalized key (dashes → underscores, collapse double underscores)
  // because WP stores the field key normalized even if acf_fc_layout has dashes.
  const nestedKey       = `layout__${layoutName}`;
  const normalizedName  = layoutName.replace(/-/g, '_').replace(/_{2,}/g, '_');
  const normalizedKey   = `layout__${normalizedName}`;
  const nested          = block[nestedKey] || block[normalizedKey];

  // Tag each section with its layout name for styling hooks. Copy rather
  // than mutate — the WP data is cached and shared across the build.
  const withLayoutClass = (settings: any) => ({
    ...settings,
    classes: [settings.classes, layoutName].filter(Boolean).join(' '),
  });

  if (nested) {
    const rawContent  = nested.layout__content || nested['layout__content'] || {};
    const rawSettings = nested.layout__settings || nested['layout__settings'] || {};

    return {
      layoutContent: transformKeys(rawContent),
      layoutSettings: transformKeys(withLayoutClass(rawSettings)),
    };
  }

  // Fallback: try flat structure (in case data shape differs)
  return {
    layoutContent: transformKeys(block.layout_content || block.layoutContent || block),
    layoutSettings: transformKeys(withLayoutClass(block.layout_settings || block.layoutSettings || {})),
  };
}
---

<div>
  {layouts?.map((block: any, index: number) => {
    const layoutName = block.acf_fc_layout;
    const componentName = resolveLayoutName(layoutName);

    if (!componentName) {
      return <div class="container py-4 text-red-500 text-sm">Layout "{layoutName}" not recognized</div>;
    }

    const Component = layoutComponents[componentName];

    if (!Component) {
      return <div class="container py-4 text-orange-500 text-sm">Layout "{componentName}" not yet implemented</div>;
    }

    const layoutData = extractLayoutData(block);

    return <Component layoutData={layoutData} />;
  })}
</div>
