---
/**
 * Dynamic layout block renderer
 * Replaces Gatsby's FlexibleLayouts.js + layoutIndex.js
 *
 * Statically imports all layout components and uses a lookup object
 * since Astro can't dynamically import .astro components by string name.
 */
import { resolveLayoutName } from '@/lib/layout-map';
import { transformKeys } from '@/lib/wp-client';

// Phase 1 layout components
import TwoColImageText from './layouts/TwoColImageText.astro';
import TextBlock from './layouts/TextBlock.astro';
import FullWidthImage from './layouts/FullWidthImage.astro';
import PageHeader from './layouts/PageHeader.astro';
import HomeHero from './layouts/HomeHero.astro';
import IconTextBoxes from './layouts/IconTextBoxes.astro';
import LogoCloud from './layouts/LogoCloud.astro';
import Quotes from './layouts/Quotes.astro';
import LineBreak from './layouts/LineBreak.astro';
import PostCards from './layouts/PostCards.astro';

// Phase 3 layout components
import Results from './layouts/Results.astro';
import ButtonRow from './layouts/ButtonRow.astro';
import FeaturedProjectsCarousel from './layouts/FeaturedProjectsCarouselWrapper.astro';
import FeaturedProjectsGridDev from './layouts/FeaturedProjectsGridDevWrapper.astro';

// Phase 4 layout components
import FullWidthImageText from './layouts/FullWidthImageText.astro';
import FullWidthImageVideoText from './layouts/FullWidthImageVideoText.astro';
