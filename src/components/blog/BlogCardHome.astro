---
/**
 * Blog card with square image — used by PostCards layout
 * Replaces Gatsby's BlogCardHome.js
 */
import WpImage from '@/components/global/WpImage.astro';
import { theme } from '@/lib/theme';

interface Props {
  heading : string;
  link    : string;
  imageSrc: string;
  imageAlt: string;
}

const { heading, link, imageSrc, imageAlt } = Astro.props;
---

<article class="w-full sm:w-[360px] md:w-[330px] lg:w-[285px] xl:w-[330px] flex flex-col mb-7 lg:mb-0 justify-between">
  <a href={link} class="flex flex-col flex-1">
    <div class="relative pt-[100%] lg:pt-0 lg:h-[330px] xl:h-[330px] mb-4 bg-grey overflow-hidden">
      {imageSrc && (
        <WpImage
          src={imageSrc}
          alt={imageAlt}
          class="absolute top-0 left-0 object-cover h-full w-full"
          divHeight='h-full'
        />
      )}
    </div>
    <div class="w-full flex flex-col flex-1">
      <h3
        class={`${theme.text.H4} mb-14 lg:mb-7 flex-1`}
        set:html={heading ?? ''}
      ></h3>
      <div>
        <span
          class={`${theme.text_links.BASE_STYLING} ${theme.text_links.STD} ${theme.text_links.FWD_BASE} ${theme.text_links.ARW_FWD_BLACK} ${theme.text_links.HOVER_ARW_FWD_GREEN} ${theme.text_links.HOVER_GREEN} w-max`}
        >
          READ ARTICLE
        </span>
      </div>
    </div>
  </a>
</article>
